; rom_emu.pio

 ; ROMエミュレータ
.program oe_address_control
.wrap_target
loop1:
    wait 0 gpio 23        ; 1: CE有効待ち
    jmp pin loop1         ; 2: OE無効なら loop1 へ戻る
    in pins, 15           ; 3: GP8-22(A0-A14) 15ピン読込
    push                  ; 4: アドレスをプッシュ
    pull                  ; 5: データをプル
    mov pindirs, ~null    ; 6: GP0-7を出力モード
    out pins, 8           ; 7: データ出力
    wait 1 gpio 24        ; 8: OE無効待ち
    mov pindirs, null     ; 9: GP0-7を入力モード
.wrap

; クロック出力  SM動作クロックデバイダの 1/2の周波数を出力 (GP26)
.program clk_out 
.wrap_target
    set pins, 1   ; Turn on
    set pins, 0   ; Turn off
.wrap


; リセット 指定時間(ms)Lowレベル出力、無効時はHi-Z (GP25)
.program reset_out
    ; --- ON: Output LOW ---
    set pindirs, 1  ; Set pin direction to output
    set pins, 0     ; Set pin value to low
.wrap_target
    pull block
    out x, 32
    ; --- ON: Output LOW ---
    set pindirs, 1  ; Set pin direction to output
    set pins, 0     ; Set pin value to low
lp1:
    nop [1]
    jmp x-- lp1 [7]    ; Delay
    ; --- OFF: Input (Hi-Z) ---
    set pindirs, 0  ; Set pin direction to input
.wrap
